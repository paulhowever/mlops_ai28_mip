ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/dota_winprob
OPENDOTA_BASE_URL=https://api.opendota.com
HEALTH_PROBE_TIMEOUT=3.0

APP_PORT=8000
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dota_winprob
POSTGRES_PORT=5433

MLFLOW_PORT=5001
MLFLOW_TRACKING_URI=http://127.0.0.1:5001
MLFLOW_EXPERIMENT=dota-winprob
MLFLOW_BUCKET=mlflow

MODEL_NAME=dota-winprob
MODEL_ALIAS=champion
MODEL_LOAD_TIMEOUT=30

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

DATA_RAW_DIR=data/raw

RABBITMQ_USER=dota
RABBITMQ_PASSWORD=dota
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://dota:dota@localhost:5672/

QUEUE_MAX_LENGTH=100
DELIVERY_LIMIT=3
MAX_ATTEMPTS=3
RETRY_DELAY_MS=1000
WORKER_CONCURRENCY=4
WORKER_PREFETCH=
INFERENCE_DELAY_MS=200
PUBLISH_TIMEOUT=1.0
GRACEFUL_TIMEOUT=30
WORKER_PORTS=8101-8104
SOURCE_BACKOFF_MIN=0.02
SOURCE_BACKOFF_MAX=0.5

GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
LOKI_PORT=3100
TEMPO_PORT=3200
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
GRAFANA_VERSION=13.2.5
LOKI_VERSION=3.7.9
TEMPO_VERSION=2.10.10
PROMETHEUS_VERSION=v3.16.0
ALLOY_VERSION=v1.21.3
OTELCOL_VERSION=0.165.0
BUSYBOX_IMAGE=busybox:1.37.0-musl
METRICS_RETENTION=2d
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_TRACES_SAMPLER_ARG=
OTEL_METRIC_EXPORT_INTERVAL=5000
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
SERVICE_VERSION=0.1.0
