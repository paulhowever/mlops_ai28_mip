ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/dota_winprob
OPENDOTA_BASE_URL=https://api.opendota.com
HEALTH_PROBE_TIMEOUT=3.0

APP_PORT=8000
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dota_winprob
POSTGRES_PORT=5433

MLFLOW_PORT=5001
MLFLOW_TRACKING_URI=http://127.0.0.1:5001
MLFLOW_EXPERIMENT=dota-winprob
MLFLOW_BUCKET=mlflow

MODEL_NAME=dota-winprob
MODEL_ALIAS=champion
MODEL_LOAD_TIMEOUT=30

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

DATA_RAW_DIR=data/raw

RABBITMQ_USER=dota
RABBITMQ_PASSWORD=dota
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://dota:dota@localhost:5672/

QUEUE_MAX_LENGTH=100
DELIVERY_LIMIT=3
MAX_ATTEMPTS=3
RETRY_DELAY_MS=1000
WORKER_CONCURRENCY=4
WORKER_PREFETCH=
INFERENCE_DELAY_MS=200
PUBLISH_TIMEOUT=1.0
GRACEFUL_TIMEOUT=30
WORKER_PORTS=8101-8104
SOURCE_BACKOFF_MIN=0.02
SOURCE_BACKOFF_MAX=0.5
