discovery.docker "project" {
  host = "unix:///var/run/docker.sock"

  filter {
    name   = "label"
    values = ["com.docker.compose.project=" + sys.env("COMPOSE_PROJECT_NAME")]
  }
}

discovery.relabel "project" {
  targets = discovery.docker.project.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    source_labels = ["service"]
    regex         = "app"
    target_label  = "service"
    replacement   = "dota-api"
  }

  rule {
    source_labels = ["service"]
    regex         = "worker"
    target_label  = "service"
    replacement   = "dota-worker"
  }

  rule {
    source_labels = ["service"]
    regex         = "source"
    target_label  = "service"
    replacement   = "dota-source"
  }
}

loki.source.docker "project" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.project.output
  forward_to = [loki.process.project.receiver]
}

loki.process "project" {
  stage.static_labels {
    values = {
      env   = coalesce(sys.env("ENVIRONMENT"), "development"),
      level = "unknown",
    }
  }

  stage.json {
    expressions = {
      level    = "level",
      env      = "environment",
      task_id  = "task_id",
      trace_id = "trace_id",
    }
  }

  stage.labels {
    values = {
      level   = "",
      env     = "",
    }
  }

  stage.structured_metadata {
    values = {
      task_id  = "",
      trace_id = "",
    }
  }

  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = sys.env("LOKI_URL")
  }
}
